flowchart LR
    classDef default fill:#E7F0EB,stroke:#1F5E4F,stroke-width:1.5px,color:#14352D

    subgraph S1["1 · Input guard"]
        direction TB
        Q["Question<br/>1–500 chars, &lt; &gt; stripped"]
        G["Refuse diagnosis, dosage,<br/>prompt injection<br/>(regex, no LLM call)"]
        Q --> G
    end

    subgraph S2["2 · Retrieval"]
        direction TB
        K["Keywords<br/>drop question and<br/>small-talk words"]
        T["MongoDB $text search<br/>skipped if no keywords"]
        R["Rank by textScore<br/>keep ≥ 0.5 · top K = 3<br/>label S1–S3"]
        K --> T --> R
    end

    subgraph S3["3 · Context"]
        direction TB
        M["Memory<br/>summary of 20 older messages<br/>+ last 10 messages · label H1"]
        P["Prompt<br/>system rules + date +<br/>&lt;context&gt; &lt;conversation&gt; &lt;question&gt;"]
        TL["Tools offered<br/>only ones the role may use"]
        M --> P --> TL
    end

    subgraph S4["4 · Inference"]
        direction TB
        L["Groq gpt-oss-20b<br/>temp 0 · 15 s timeout<br/>reply type: answer · chat ·<br/>cannot_answer"]
        TC["Tools · ≤ 2 rounds<br/>patient details · appointments<br/>search_records (AI-built query)<br/>results labelled T1, T2"]
        L --> TC
    end

    subgraph S5["5 · Verification"]
        direction TB
        J1["answer: cited IDs<br/>really provided"]
        J2["Judge: answers the question<br/>and every fact is in the<br/>cited text"]
        J3["chat: judge confirms<br/>it states no facts"]
        J1 --> J2
        J2 ~~~ J3
    end

    subgraph S6["6 · Response"]
        direction TB
        A["Answer + source labels<br/>or chat reply"]
        SV["Saved to conversations<br/>summary refreshed in background"]
        A --> SV
    end

    S1 --> S2 --> S3 --> S4 --> S5 --> S6

    style S1 fill:#F6FAF8,stroke:#1F5E4F,stroke-width:1.5px
    style S2 fill:#F6FAF8,stroke:#1F5E4F,stroke-width:1.5px
    style S3 fill:#F6FAF8,stroke:#1F5E4F,stroke-width:1.5px
    style S4 fill:#F6FAF8,stroke:#1F5E4F,stroke-width:1.5px
    style S5 fill:#FFF4EC,stroke:#C0704A,stroke-width:1.5px
    style S6 fill:#F6FAF8,stroke:#1F5E4F,stroke-width:1.5px
