flowchart LR
    classDef default fill:#E7F0EB,stroke:#1F5E4F,stroke-width:1.5px,color:#14352D

    subgraph S1["1 · Input guardrails"]
        direction TB
        Q["Input validation<br/>1–500 chars · tag stripping"]
        G["Rule-based filter<br/>diagnosis · dosage<br/>prompt injection<br/>(no LLM call)"]
        Q --> G
    end

    subgraph S2["2 · Retrieval"]
        direction TB
        K["Query normalisation<br/>stop-word removal<br/>(skip if no keywords)"]
        T["Lexical search<br/>MongoDB $text index<br/>on faq_sections"]
        R["Ranking<br/>textScore ≥ 0.5 · top-k = 3<br/>chunk IDs S1–S3"]
        K --> T --> R
    end

    subgraph S3["3 · Context construction"]
        direction TB
        M["Session memory<br/>rolling summary (20 msgs)<br/>+ sliding window (10 msgs) · H1"]
        P["Prompt assembly<br/>system rules + date +<br/>&lt;context&gt; &lt;conversation&gt; &lt;question&gt;"]
        TL["Tool schemas<br/>filtered by RBAC role"]
        M --> P --> TL
    end

    subgraph S4["4 · LLM inference"]
        direction TB
        L["Groq gpt-oss-20b<br/>temp 0 · stream=true<br/>structured JSON output<br/>type: answer · chat · cannot_answer"]
        TC["Function calling · ≤ 2 rounds<br/>get_patient_details<br/>get_patient_appointments<br/>search_records (AI-built query)<br/>results → T1, T2"]
        L --> TC
    end

    subgraph S5["5 · Verification"]
        direction TB
        J1["Citation check<br/>cited IDs ⊆ provided IDs"]
        J2["LLM-as-judge (grounding)<br/>answers question +<br/>every fact in cited text"]
        J3["LLM-as-judge (chat)<br/>no factual claims"]
        J1 --> J2
        J2 ~~~ J3
    end

    subgraph S6["6 · Response delivery"]
        direction TB
        A["SSE events<br/>status → draft tokens<br/>→ done (verified reply)"]
        SV["Persistence<br/>conversation saved<br/>async summary refresh"]
        A --> SV
    end

    S1 --> S2 --> S3 --> S4 --> S5 --> S6

    style S1 fill:#F6FAF8,stroke:#1F5E4F,stroke-width:1.5px
    style S2 fill:#F6FAF8,stroke:#1F5E4F,stroke-width:1.5px
    style S3 fill:#F6FAF8,stroke:#1F5E4F,stroke-width:1.5px
    style S4 fill:#F6FAF8,stroke:#1F5E4F,stroke-width:1.5px
    style S5 fill:#FFF4EC,stroke:#C0704A,stroke-width:1.5px
    style S6 fill:#F6FAF8,stroke:#1F5E4F,stroke-width:1.5px
