# Copy to backend/.env and fill in (or run "make env", which does it for you). Never commit backend/.env.

# MongoDB connection string including the database name, e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/patient_management
MONGO_URI=
# A separate database used only by the tests, e.g. .../patient_management_test
MONGO_URI_TEST=
# Long random string used to sign login tokens, e.g. the output of: openssl rand -hex 32
JWT_SECRET=
# From https://console.groq.com/keys (backend only)
GROQ_API_KEY=
# Optional, defaults to openai/gpt-oss-20b
GROQ_MODEL=
# Optional, defaults to 5050
PORT=
# Optional, frontend URL(s) allowed by CORS, comma-separated; defaults to http://localhost:5173
CLIENT_ORIGIN=
