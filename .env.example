# Copy this file to backend/.env and fill in real values. Never commit backend/.env.
# Variable names only: no real secrets belong in this file.
PORT=5050

# MongoDB connection strings, including the database name (see backend/setup/README.md). Examples:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/patient_management?retryWrites=true&w=majority
#   mongodb://127.0.0.1:27017/patient_management
MONGO_URI=
# A separate database used only by the tests (npm test drops it on every run).
MONGO_URI_TEST=

# Random secret used to sign login tokens, e.g. the output of: openssl rand -hex 32
JWT_SECRET=

# Groq API key from https://console.groq.com/keys (used only by the backend).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Frontend URL(s) allowed by CORS, comma-separated, e.g. http://localhost:5173,https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173
